# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=syntra_db

# Security & Authentication
JWT_SECRET=change_this_to_a_secure_random_key_in_production
JWT_EXPIRES_IN=604800

# OTP Settings
OTP_EXPIRES_IN_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
DEMO_OTP_IN_RESPONSE=true

# Real Email Delivery (SMTP - e.g. Gmail, SendGrid, Mailgun)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="SYNTRA Security"

# Real SMS Delivery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


